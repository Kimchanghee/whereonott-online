{
  "name": "whereonott",
  "version": "0.1.0",
  "private": true,
  "description": "Where to watch — movie & series OTT availability finder (KR/EN/JA)",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "sync-tmdb": "tsx scripts/sync-tmdb.ts",
    "translate:all": "tsx scripts/translate-all.ts",
    "deploy": "npm run sync-tmdb && npm run translate:all && npm run build && cdk deploy --require-approval never"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next-intl": "^3.20.0",
    "tailwindcss": "^3.4.13",
    "lucide-react": "^0.452.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "aws-cdk": "^2.160.0",
    "aws-cdk-lib": "^2.160.0",
    "@aws-sdk/client-bedrock-runtime": "^3.665.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
