---
import Base from '../../layouts/Base.astro';
import { allGuides, allPosts, guidePath, postPath, ymd } from '../../lib/content';
import { thumbOf, isDiagram } from '../../lib/media';
import { site } from '../../site.config';

export async function getStaticPaths() {
  return (await import('../../data/site.json')).default.categories.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
interface Props { cat: { slug: string; name: string; code: string; blurb: string; answer: string } }
const { cat } = Astro.props;
const guides = (await allGuides()).filter((g) => g.data.category === cat.slug);
const posts = (await allPosts()).filter((p) => p.data.category === cat.slug);
const path = `/category/${cat.slug}/`;
const updated = [...guides, ...posts].map((e) => e.data.updated).sort().at(-1);
const title = `${cat.name} 장비 고르는 법과 구매 체크리스트 | ${site.name}`;
const description = `${cat.blurb} ${cat.name} 체크리스트 ${guides.length}개와 링크를 확인한 장비 추천 글을 한곳에 모았습니다. 각 글에 출처와 수정일을 표시합니다.`;
const crumbs = [{ name: '홈', href: '/' }, { name: cat.name, href: path }];
const ld = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, url: site.url + path, description, abstract: cat.answer, ...(updated ? { dateModified: updated } : {}) }];
---
<Base title={title} description={description} path={path} updated={updated} crumbs={crumbs} ogImage={`/og/category/${cat.slug}.png`}>
  <div class="section">
    <p class="kicker">{cat.code} · 분야별 모음</p>
    <h1 class="list-title">{cat.name} 장비, 무엇부터 확인할까?</h1>
    <section class="answer-box" aria-label="먼저 결론" style="max-width:var(--col)">
      <p class="answer-box__k">먼저 결론</p>
      <p class="answer" data-gate="answer">{cat.answer}</p>
    </section>
    {updated && <p class="meta"><span>마지막 갱신 <time datetime={updated}>{ymd(updated)}</time></span><span>체크리스트 {guides.length}편</span><span>상품 노트 {posts.length}편</span></p>}
    <p class="lede">{cat.blurb} 아래 체크리스트를 먼저 보고, 상품 추천 글은 링크가 실제 옵션으로 연결되는지 확인된 것만 모았습니다.</p>
    <div class="section__head" style="margin-top:32px"><h2>체크리스트</h2><p>{guides.length}편</p></div>
    <table class="logtable">
      <tbody>{guides.map((g) => (
        <tr><td class="code">{cat.code}</td><td><a href={guidePath(g.data.slug)}>{g.data.title}</a><span class="sub">{g.data.answer}</span></td><td class="date">{ymd(g.data.updated)}</td></tr>
      ))}</tbody>
    </table>
    <div class="section__head" style="margin-top:36px"><h2>장비 추천 글</h2><p>{posts.length}편</p></div>
    {posts.length === 0 ? (
      <p class="empty" style="margin-top:16px">{cat.name} 분야 상품 추천 글은 아직 없습니다. 추천 글은 판매 링크와 옵션을 확인한 뒤에만 발행합니다.</p>
    ) : (
      <ul class="pick-list">{posts.map((p) => { const t = thumbOf(p.data.images); return (
        <li class="pick-tile"><img src={t.src} alt={t.alt} width="168" height="126" style={isDiagram(t) ? 'object-fit:contain' : undefined} loading="lazy" decoding="async" /><div><h3><a href={postPath(p.data.slug)}>{p.data.title}</a></h3><p>{p.data.product.name}</p><p class="meta"><span>제휴 링크 포함</span><time datetime={p.data.published}>{ymd(p.data.published)}</time></p></div></li>
      ); })}</ul>
    )}
    <p class="cat-links"><a href="/guides/">전체 체크리스트</a> · <a href="/methodology/">상품 선정 방법</a></p>
  </div>
</Base>
