---
import Base from '../layouts/Base.astro';import pages from '../data/legal.json';
export function getStaticPaths(){return ['about','methodology','contact','privacy','terms','disclaimer'].map(slug=>({params:{slug}}))}
const p=pages[Astro.params.slug as keyof typeof pages];
---
<Base title={p[0]}><article class="article"><h1>{p[0]}</h1><p>{p[1]}</p><p>정책 기준일: 2026-10-16</p><a href="/guides/">구매 기준 가이드</a> · <a href="/contact/">문의</a></article></Base>

