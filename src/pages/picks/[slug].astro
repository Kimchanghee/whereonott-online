---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import Checklist from '../../components/Checklist.astro';
import AdSlot from '../../components/AdSlot.astro';
import { allPosts, allGuides, postPath, guidePath, articleLd, faqLd, ymd, disclosureFor, type Post } from '../../lib/content';
import { imgSize, thumbOf, isDiagram } from '../../lib/media';
import { categoryBySlug, providerInfo } from '../../site.config';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((p) => ({ params: { slug: p.data.slug }, props: { post: p } }));
}
interface Props { post: Post }
const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const cat = categoryBySlug(d.category)!;
const path = postPath(d.slug);
const cover = d.images.find((i) => i.role === 'cover') ?? d.images[0];
const coverSize = await imgSize(cover.src);
const coverIsDiagram = isDiagram(cover);
const thumb = thumbOf(d.images);
const thumbSize = await imgSize(thumb.src);
const og = `/og/picks/${d.slug}.png`;
const guides = (await allGuides()).filter((g) => g.data.category === d.category).slice(0, 3);
const prov = providerInfo(d.product.provider);
const shop = prov.name.replace(' 파트너스', '');
const dot = (iso: string) => ymd(iso).replaceAll('-', '.');
const ld = [articleLd('post', post, path, og), faqLd(d.faq)].filter(Boolean) as Record<string, unknown>[];
const crumbs = [ { name: '홈', href: '/' }, { name: cat.name, href: `/category/${cat.slug}/` }, { name: d.title, href: path } ];
---
<Base title={d.title} description={d.description} path={path} ogImage={og} ogType="article" jsonld={ld} crumbs={crumbs} published={d.published} updated={d.updated}>
  <div class="pv2">
    <div class="pv2__grid">
      <article class="pv2__article" data-gate="article">
        <p class="pv2__disclosure" data-gate="disclosure"><span>제휴 고지</span> {disclosureFor(post)}</p>
        <header class="pv2__head">
          <p class="pv2__crumb"><a href={`/category/${cat.slug}/`}>{cat.name}</a> <span aria-hidden="true">·</span> 구매 전 확인 노트</p>
          <h1>{d.title}</h1>
          <p class="pv2__byline"><span>거실상영관 편집팀</span><span>발행 <time datetime={d.published}>{dot(d.published)}</time></span>{d.updated !== d.published && <span>수정 <time datetime={d.updated}>{dot(d.updated)}</time></span>}<span>링크 확인 {dot(d.product.verifiedAt)}</span></p>
        </header>
        <figure class={`pv2__hero${coverIsDiagram ? ' pv2__hero--diagram' : ''}`}>
          <img src={cover.src} alt={cover.alt} width={coverSize.width} height={coverSize.height} loading="eager" fetchpriority="high" decoding="async" />
        </figure>
        <section class="answer-box" aria-label="먼저 결론">
          <p class="answer-box__k">먼저 결론</p>
          <p class="answer" data-gate="answer">{d.answer}</p>
        </section>
        <ProductCard product={d.product} thumb={thumb} variant="inline" />
        <div class="pv2__prose" data-gate="body"><Content /></div>
        {d.faq.length > 0 && (
          <section class="pv2__faq" data-gate="faq" aria-labelledby="faq-h">
            <h2 id="faq-h">자주 묻는 질문</h2>
            {d.faq.map((f) => (<details open><summary>{f.q}</summary><p>{f.a}</p></details>))}
          </section>
        )}
        {d.checklist && d.checklist.length > 0 && (
          <div class="pv2__check" data-gate="checklist">
            <Checklist id={d.slug} items={d.checklist} title="주문하기 전에 무엇을 확인할까?" />
            {d.checklistNote && <p class="pv2__check-note">{d.checklistNote}</p>}
          </div>
        )}
        <div class="pv2__end">
          <img src={thumb.src} alt="" width={thumbSize.width} height={thumbSize.height} style={isDiagram(thumb) ? 'object-fit:contain' : undefined} loading="lazy" decoding="async" />
          <div>
            <p class="pv2__end-name">{d.product.name} <span>{d.product.optionDetail}</span></p>
            <a class="pv2__btn" href={d.product.url} rel="sponsored nofollow noopener" target="_blank" data-product-link="end">{shop}에서 옵션 확인하기</a>
            <p class="pv2__end-note">{prov.name} 제휴 링크입니다. 옵션·가격·배송 조건은 판매 페이지에서 마지막으로 확인하세요.</p>
          </div>
        </div>
        <AdSlot id="pick-end" />
        <section class="pv2__sources" data-gate="sources">
          <h2>참고한 공식 자료</h2>
          <ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}</ul>
        </section>
        <nav class="pv2__related" aria-labelledby="rel-h">
          <h2 id="rel-h">함께 보면 좋은 상영 준비 가이드</h2>
          <ul>{guides.map((g) => <li><a href={guidePath(g.data.slug)}>{g.data.title}</a></li>)}</ul>
          <p><a href={`/category/${cat.slug}/`}>{cat.name} 전체 보기</a> · <a href="/methodology/">상품 선정 방법</a></p>
        </nav>
      </article>
      <aside class="pv2__side" aria-label="상품 카드">
        <div class="pv2__sticky"><ProductCard product={d.product} thumb={thumb} variant="side" /></div>
      </aside>
    </div>
  </div>
</Base>
