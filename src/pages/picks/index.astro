---
import Base from '../../layouts/Base.astro';
import { allPosts, postPath, ymd } from '../../lib/content';
import { thumbOf, isDiagram } from '../../lib/media';
const posts = await allPosts();
const title = '링크를 확인한 홈시네마 장비 추천 글 목록';
const description = '판매 링크가 실제 상품과 옵션으로 연결되는지 확인한 뒤 발행한 홈시네마 장비 추천 글 목록입니다. 모든 추천 글은 제휴 링크를 포함하며 글 맨 위에 제휴 사실을 표시합니다.';
const crumbs = [{ name: '홈', href: '/' }, { name: '장비 추천', href: '/picks/' }];
---
<Base title={title} description={description} path="/picks/" crumbs={crumbs}>
  <div class="section">
    <p class="kicker">상품 노트</p>
    <h1 class="list-title">장비 추천 글</h1>
    <p class="lede">추천 글은 모두 제휴 링크를 포함합니다. 기준은 <a href="/methodology/">상품 선정 방법</a>에, 고르는 법은 <a href="/guides/">체크리스트</a>에 있습니다.</p>
    {posts.length === 0 ? (
      <p class="empty" style="margin-top:20px">아직 발행된 추천 글이 없습니다. 링크와 옵션 확인을 마친 글부터 순서대로 올라옵니다.</p>
    ) : (
      <ul class="pick-list" style="margin-top:28px">{posts.map((p) => { const t = thumbOf(p.data.images); return (
        <li class="pick-tile"><img src={t.src} alt={t.alt} width="168" height="126" style={isDiagram(t) ? 'object-fit:contain' : undefined} loading="lazy" decoding="async" /><div><h3><a href={postPath(p.data.slug)}>{p.data.title}</a></h3><p>{p.data.product.name}</p><p class="meta"><span>제휴 링크 포함</span><time datetime={p.data.published}>{ymd(p.data.published)}</time></p></div></li>
      ); })}</ul>
    )}
  </div>
</Base>
