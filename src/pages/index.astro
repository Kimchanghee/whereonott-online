---
import Base from '../layouts/Base.astro';import {siteEntries} from '../lib/seo';import {ymd,postPath,guidePath} from '../lib/content';import {thumbOf,isDiagram} from '../lib/media';
const {guides,posts,latest}=await siteEntries();
---
<Base title="홈시네마 구매 가이드와 거실 상영 준비" path="/" updated={latest}>
  <section class="opening">
    <div>
      <p class="kicker">상영 전 확인 노트</p>
      <h1>오늘의 영화보다 먼저,<br/>우리 집의 조건.</h1>
      <p>더 큰 화면, 더 많은 스피커가 항상 정답은 아닙니다. 벽까지의 거리와 TV 뒷면의 단자부터 확인하세요.</p>
      <p class="meta"><span>마지막 갱신 <time datetime={latest}>{ymd(latest)}</time></span><span>가이드 {guides.length}편</span><span>상품 노트 {posts.length}편</span></p>
      <a class="opening__cta" href="/guides/">상영 준비 가이드 읽기 ↓</a>
    </div>
    <aside class="screen"><strong>거리 → 연결 → 자리</strong><p>장비 이름 대신 거실의 문제에서 출발하는 홈시네마 구매 노트.</p></aside>
  </section>
  {posts.length>0&&<section class="shelf" aria-labelledby="picks-h">
    <div class="shelf__head"><h2 id="picks-h">새 상품 노트</h2><a href="/picks/">전체 보기</a></div>
    <ul class="pick-list">{posts.slice(0,4).map(p=>{const t=thumbOf(p.data.images);return <li class="pick-tile"><img src={t.src} alt={t.alt} width="168" height="126" style={isDiagram(t)?'object-fit:contain':undefined} loading="lazy" decoding="async"/><div><h3><a href={postPath(p.data.slug)}>{p.data.title}</a></h3><p>{p.data.product.name}</p><p class="meta"><span>제휴 링크 포함</span><time datetime={p.data.published}>{ymd(p.data.published)}</time></p></div></li>})}</ul>
  </section>}
  <section class="shelf" aria-labelledby="guides-h">
    <div class="shelf__head"><h2 id="guides-h">구매 전 읽을거리</h2><a href="/guides/">가이드 목록</a></div>
    {guides.map((g,i)=><article class="program-row"><span class="number">{String(i+1).padStart(2,'0')}</span><div><h3><a href={guidePath(g.data.slug)}>{g.data.title}</a></h3><p>{g.data.answer}</p><p class="meta">기준일 {g.data.data_asof}</p></div></article>)}
  </section>
  <p class="cat-links"><a href="/category/picture/">화면과 거리</a> · <a href="/category/sound/">소리와 연결</a> · <a href="/category/room/">상영 공간</a></p>
</Base>
