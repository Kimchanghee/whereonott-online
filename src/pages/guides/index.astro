---
import Base from '../../layouts/Base.astro';import{getCollection}from'astro:content';const guides=await getCollection('guides');
---
<Base title="홈시네마 구매 기준 전체 상영 프로그램"><h1>상영 준비 가이드</h1><p class="answer">프로젝터는 설치 거리, 사운드바는 연결 단자부터 확인하세요. 가격 순위 대신 집에 맞는 조건을 정리합니다.</p>{guides.map((g,i)=><article class="program-row"><span class="number">0{i+1}</span><div><h2><a href={'/guides/'+g.data.slug+'/'}>{g.data.title}</a></h2><p>{g.data.answer}</p></div></article>)}</Base>
