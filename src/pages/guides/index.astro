---
import Base from '../../layouts/Base.astro';import {PAGE_META} from '../../lib/seo';import{getCollection}from'astro:content';const guides=await getCollection('guides', ({data}) => !data.draft);
---
<Base title={PAGE_META.guides.title} description={PAGE_META.guides.description} pageType={PAGE_META.guides.type} path="/guides/">
  <div class="section">
    <p class="kicker">상영 준비</p>
    <h1 class="list-title">상영 준비 가이드</h1>
    <section class="answer-box" aria-label="먼저 결론" style="max-width:var(--col)"><p class="answer-box__k">먼저 결론</p><p class="answer">프로젝터는 설치 거리, 사운드바는 연결 단자부터 확인하세요. 가격 순위 대신 집에 맞는 조건을 정리합니다.</p></section>
    {guides.map((g,i)=><article class="program-row"><span class="number">{String(i+1).padStart(2,'0')}</span><div><h2><a href={'/guides/'+g.data.slug+'/'}>{g.data.title}</a></h2><p>{g.data.answer}</p></div></article>)}
    <p class="cat-links"><a href="/category/picture/">화면과 거리</a> · <a href="/category/sound/">소리와 연결</a> · <a href="/category/room/">상영 공간</a></p>
  </div>
</Base>
