---
import Base from '../../layouts/Base.astro';import{getCollection,render}from'astro:content';export async function getStaticPaths(){return(await getCollection('guides')).map(entry=>({params:{slug:entry.data.slug},props:{entry}}))}const{entry}=Astro.props;const d=entry.data;const{Content}=await render(entry);
---
<Base title={d.title} description={d.description}><a href="/guides/">← 전체 프로그램</a><div class="meta">구매 기준 · {d.data_asof} · 거실상영관 편집</div><h1>{d.question}</h1><p class="answer">{d.answer}</p><article class="article"><Content/><h2>구매 전 확인할 항목은?</h2><ul>{d.checklist.map(c=><li>{c}</li>)}</ul><h2>어떤 자료를 참고했나요?</h2><ul>{d.sources.map(s=><li><a href={s.url}>{s.title}</a></li>)}</ul><p><a href="/methodology/">편집 기준</a> · <a href="/guides/">다른 구매 가이드</a></p></article></Base>
